---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  imageAlt?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  imageAlt = 'BurrowTime gopher mascot holding a pocket watch beside a terminal',
  noindex = false,
} = Astro.props;

const pageTitle = title === 'BurrowTime' ? title : `${title} | BurrowTime`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const socialImage = new URL('burrowtime-mascot.png', Astro.site ?? Astro.url.origin);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'BurrowTime',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Linux, macOS, Windows',
  description:
    'Open-source, local-first time tracking for developers and coding agents, with a terminal UI, CLI, agent skills, and an MCP server.',
  url: new URL(import.meta.env.BASE_URL, Astro.site ?? Astro.url.origin).toString(),
  downloadUrl: 'https://github.com/fabean/BurrowTime/releases/latest',
  softwareVersion: '0.1.2',
  license: 'https://opensource.org/license/mit',
  isAccessibleForFree: true,
  codeRepository: 'https://github.com/fabean/BurrowTime',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="coding agent time tracking, AI agent time tracker, MCP time tracking, Codex, Claude Code, Cursor, Gemini CLI, OpenCode, Watson CLI"
    />
    <meta name="theme-color" content="#16382b" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}burrowtime-mascot.png`} />
    <link rel="manifest" href={`${import.meta.env.BASE_URL}site.webmanifest`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BurrowTime" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{pageTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
