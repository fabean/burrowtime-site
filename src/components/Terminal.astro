---
interface Props {
  title?: string;
}

const { title = 'terminal' } = Astro.props;
---

<div class="terminal" aria-label={title}>
  <div class="terminal-bar" aria-hidden="true">
    <span></span><span></span><span></span>
    <small>{title}</small>
  </div>
  <div class="terminal-body"><slot /></div>
</div>
